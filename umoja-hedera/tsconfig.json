{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true
  },
  "include": ["scripts/relayer.ts", "hedera-watcher.ts", "polygon-minter.ts", "types.ts"],
  "exclude": ["node_modules", "artifacts", "dist"]
}
